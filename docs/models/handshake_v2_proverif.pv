(* ProVerif sketch for Omega Handshake v2. This is a phase_02 engineering model, not a final proof artifact. *)

free c : channel.
free client_addr, server_addr : bitstring.
free conn_id : bitstring.
free cookie : bitstring.
free ticket : bitstring.
free x25519_shared, mlkem_shared, resumption_secret : bitstring [private].
free device_id, device_token : bitstring [private].
free transcript_hash : bitstring.
free app_secret : bitstring [private].

fun hkdf(bitstring, bitstring): bitstring.
fun pair(bitstring, bitstring): bitstring.
reduc forall x:bitstring, y:bitstring; fst(pair(x,y)) = x.
reduc forall x:bitstring, y:bitstring; snd(pair(x,y)) = y.

fun wrap_cred(bitstring, bitstring): bitstring.
reduc forall k:bitstring, m:bitstring; unwrap_cred(k, wrap_cred(k, m)) = m.
fun unwrap_cred(bitstring, bitstring): bitstring.

fun make_cookie(bitstring, bitstring, bitstring): bitstring.
fun check_cookie(bitstring): bitstring.
fun make_ticket(bitstring, bitstring): bitstring.
fun check_ticket(bitstring): bitstring.

query attacker(device_id).
query attacker(device_token).
query attacker(app_secret).

query event(server_established(bitstring, bitstring)) ==> event(client_finished(bitstring, bitstring)).
query event(server_resumed(bitstring)) ==> event(client_resume(bitstring)).

let ClientFresh =
    out(c, pair(conn_id, x25519_shared));
    in(c, cookie);
    let cred = wrap_cred(hkdf(x25519_shared, cookie), pair(device_id, device_token)) in
    out(c, pair(cookie, cred));
    out(c, mlkem_shared);
    event(client_finished(conn_id, device_id));
    0.

let ServerFresh =
    in(c, pair(conn_id, x25519_shared));
    let retry = make_cookie(conn_id, client_addr, server_addr) in
    out(c, retry);
    in(c, pair(cookie, ?cred_cipher));
    let _cookie_ok = check_cookie(cookie) in
    let _cred = unwrap_cred(hkdf(x25519_shared, cookie), cred_cipher) in
    in(c, mlkem_shared);
    let app_secret = hkdf(pair(x25519_shared, mlkem_shared), transcript_hash) in
    event(server_established(conn_id, device_id));
    out(c, make_ticket(device_id, resumption_secret));
    0.

let ClientResume =
    out(c, pair(conn_id, x25519_shared));
    in(c, cookie);
    event(client_resume(conn_id));
    out(c, pair(cookie, ticket));
    0.

let ServerResume =
    in(c, pair(conn_id, x25519_shared));
    out(c, make_cookie(conn_id, client_addr, server_addr));
    in(c, pair(cookie, ticket));
    let _cookie_ok = check_cookie(cookie) in
    let _ticket_ok = check_ticket(ticket) in
    event(server_resumed(conn_id));
    0.

process
    (!ClientFresh | !ServerFresh | !ClientResume | !ServerResume)
