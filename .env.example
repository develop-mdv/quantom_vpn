# Copy this file to .env and fill with your values

OMEGA_SERVER=203.0.113.1:51820
OMEGA_DEVICE_ID=11111111-2222-3333-4444-555555555555
OMEGA_DEVICE_TOKEN=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef
OMEGA_DEVICE_NAME=my-laptop
OMEGA_PLATFORM=windows

# Connection profile:
# gaming = UDP-first with keepalive 25 and conservative MTU for Steam/Dota
# general = ordinary browsing/streaming profile
# restricted = fallback profile with the smallest MTU preset
OMEGA_PROFILE=gaming

# Tunnel mode:
# full  = route all IPv4 traffic through the tunnel
# split = route only OMEGA_SPLIT_ROUTES through the tunnel
OMEGA_TUNNEL_MODE=full
# Example split routes:
# OMEGA_SPLIT_ROUTES=1.1.1.0/24,8.8.8.0/24

# Optional network tuning:
# Tunnel MTU override. Gaming profile defaults to 1380.
OMEGA_TUN_MTU=1380
# Traffic morphing / padding policy:
# balanced = lower padding budget for better latency while keeping some disguise
# full     = original morphing behavior with the largest padding budget
# off      = disable padding completely for the lowest latency
OMEGA_MORPHING=balanced
# Keepalive ping interval (seconds). Gaming profile defaults to 25.
OMEGA_KEEPALIVE_SECS=25
# UDP socket buffers. Keep them large on high-RTT/high-throughput links.
OMEGA_UDP_RCVBUF=8388608
OMEGA_UDP_SNDBUF=8388608
# Handshake retry behavior.
OMEGA_HANDSHAKE_ATTEMPTS=5
OMEGA_HANDSHAKE_TIMEOUT_MS=1500
OMEGA_HANDSHAKE_BACKOFF_MS=500

# DNS policy:
# tunnel = set VPN DNS on the Wintun adapter
# system = keep system DNS untouched (recommended for split tunnel)
OMEGA_DNS_POLICY=tunnel

# Optional DNS servers for full-tunnel mode.
# Comma-separated IPv4 list. Example:
OMEGA_DNS_SERVERS=1.1.1.1,8.8.8.8

# IPv6 policy:
# disabled    = block direct IPv6 while VPN is active
# passthrough = keep system IPv6 untouched
OMEGA_IPV6_POLICY=disabled

# Optional post-connect UDP check.
# Default behavior is enabled inside the client; set to 0 only if needed.
OMEGA_NETWORK_DIAG=1

# Optional diagnostics snapshot path.
OMEGA_DIAGNOSTICS_PATH=omega-client/state/diagnostics.json
