# Copy this file to .env and fill with your values

OMEGA_SERVER=203.0.113.1:51820
OMEGA_DEVICE_ID=11111111-2222-3333-4444-555555555555
OMEGA_DEVICE_TOKEN=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef
OMEGA_DEVICE_NAME=my-laptop
OMEGA_PLATFORM=windows

# Optional network tuning for unstable links:
# Keepalive ping interval (seconds). Minimum enforced value is 5.
OMEGA_KEEPALIVE_SECS=15
# Handshake retry behavior.
OMEGA_HANDSHAKE_ATTEMPTS=5
OMEGA_HANDSHAKE_TIMEOUT_MS=1500
OMEGA_HANDSHAKE_BACKOFF_MS=500

# Optional DNS servers for Windows full-tunnel mode.
# Comma-separated IPv4 list. Example:
# OMEGA_DNS_SERVERS=1.1.1.1,8.8.8.8
