[Unit]
Description=Omega VPN Server
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=root
# Adjust path as necessary
WorkingDirectory=/opt/omega
ExecStart=/opt/omega/omega-server
Environment=RUST_LOG=info
Environment=OMEGA_BIND=0.0.0.0:443
Environment=OMEGA_ADMIN_WEB_BIND=0.0.0.0:8081
Environment=OMEGA_METRICS_BIND=0.0.0.0:9090
Environment=OMEGA_UDP_RCVBUF=8388608
Environment=OMEGA_UDP_SNDBUF=8388608
Environment=OMEGA_IDENTITY_DB=/opt/omega/state/identity.json
Environment=OMEGA_SESSION_SNAPSHOT=/opt/omega/state/sessions.json
Environment=OMEGA_ADMIN_COMMANDS=/opt/omega/state/admin_commands.ndjson
EnvironmentFile=-/etc/default/omega-server
Restart=always
RestartSec=3
LimitNOFILE=65536
CapabilityBoundingSet=CAP_NET_ADMIN CAP_NET_BIND_SERVICE
AmbientCapabilities=CAP_NET_ADMIN CAP_NET_BIND_SERVICE

[Install]
WantedBy=multi-user.target
