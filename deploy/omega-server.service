[Unit]
Description=Omega VPN Server
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=root
# Adjust path as necessary
WorkingDirectory=/opt/omega
ExecStart=/opt/omega/omega-server
Environment=RUST_LOG=info
Environment=OMEGA_BIND=[::]:443
Environment=OMEGA_TCP_ENABLE=1
Environment=OMEGA_TCP_BIND=[::]:443
Environment=OMEGA_PROFILE=gaming
Environment=OMEGA_TUN_MTU=1380
Environment=OMEGA_IPV6_MODE=nat66
Environment=OMEGA_ADMIN_WEB_PUBLIC=1
Environment=OMEGA_ADMIN_WEB_PORT=8081
Environment=OMEGA_UDP_RCVBUF=8388608
Environment=OMEGA_UDP_SNDBUF=8388608
Environment=OMEGA_IDENTITY_DB=/opt/omega/state/identity.json
Environment=OMEGA_SESSION_SNAPSHOT=/opt/omega/state/sessions.json
Environment=OMEGA_RUNTIME_SNAPSHOT=/opt/omega/state/runtime.json
Environment=OMEGA_ADMIN_COMMANDS=/opt/omega/state/admin_commands.ndjson

# REALITY masquerade is configured at runtime through the admin web UI
# (http://<server>:8081). The server reads state/reality_config.json and
# state/reality_x25519.key on every change. Legacy `OMEGA_REALITY_*` env
# vars are still honoured for first-boot bootstrap when the JSON file does
# not yet exist; after that point the admin UI is the source of truth.

EnvironmentFile=-/etc/default/omega-server
Restart=always
RestartSec=3
LimitNOFILE=65536
CapabilityBoundingSet=CAP_NET_ADMIN CAP_NET_BIND_SERVICE
AmbientCapabilities=CAP_NET_ADMIN CAP_NET_BIND_SERVICE

[Install]
WantedBy=multi-user.target
