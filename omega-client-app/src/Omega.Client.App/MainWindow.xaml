<Window x:Class="Omega.Client.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Omega VPN"
        Icon="Assets/omega-vpn.ico"
        Width="560"
        Height="720"
        MinWidth="460"
        MinHeight="620"
        Background="{StaticResource BgBrush}"
        Foreground="{StaticResource TextBrush}"
        WindowStartupLocation="CenterScreen">
    <Window.Resources>
        <Style TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
            <Setter Property="FontFamily" Value="Segoe UI" />
        </Style>
        <Style TargetType="TextBox">
            <Setter Property="Margin" Value="0,6,0,14" />
            <Setter Property="Padding" Value="12,9" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="Background" Value="{StaticResource PanelAltBrush}" />
            <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
            <Setter Property="BorderBrush" Value="#2D3944" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CaretBrush" Value="{StaticResource TextBrush}" />
        </Style>
        <Style TargetType="PasswordBox">
            <Setter Property="Margin" Value="0,6,0,14" />
            <Setter Property="Padding" Value="12,9" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="Background" Value="{StaticResource PanelAltBrush}" />
            <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
            <Setter Property="BorderBrush" Value="#2D3944" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CaretBrush" Value="{StaticResource TextBrush}" />
        </Style>
        <Style TargetType="ComboBox">
            <Setter Property="Margin" Value="0,6,0,14" />
            <Setter Property="Padding" Value="10,7" />
            <Setter Property="FontSize" Value="14" />
        </Style>
        <Style TargetType="Button">
            <Setter Property="MinHeight" Value="46" />
            <Setter Property="Padding" Value="18,10" />
            <Setter Property="FontSize" Value="15" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Cursor" Value="Hand" />
        </Style>
        <Style x:Key="PrimaryButtonStyle" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Background" Value="{StaticResource AccentBrush}" />
            <Setter Property="Foreground" Value="#06130D" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Root"
                                Background="{TemplateBinding Background}"
                                CornerRadius="6">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"
                                              Margin="{TemplateBinding Padding}" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Root" Property="Opacity" Value="0.9" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Root" Property="Opacity" Value="0.8" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Root" Property="Background" Value="#2D3944" />
                                <Setter Property="Foreground" Value="{StaticResource MutedTextBrush}" />
                                <Setter Property="Cursor" Value="Arrow" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid Margin="28">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Margin="0,0,0,20">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="52" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Image Source="Assets/omega-vpn.png"
                       Width="42"
                       Height="42"
                       VerticalAlignment="Center" />
                <StackPanel Grid.Column="1">
                    <TextBlock Text="Omega VPN" FontSize="30" FontWeight="SemiBold" />
                    <TextBlock Text="Быстрое и понятное подключение" Foreground="{StaticResource MutedTextBrush}" Margin="0,4,0,0" />
                </StackPanel>
            </Grid>
            <Border Grid.Column="1"
                    x:Name="StatusDot"
                    Width="16"
                    Height="16"
                    CornerRadius="8"
                    Background="#5D6A75"
                    VerticalAlignment="Center" />
        </Grid>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <Border Background="{StaticResource PanelBrush}" CornerRadius="8" Padding="20" Margin="0,0,0,16">
                    <StackPanel>
                        <TextBlock Text="Статус" Foreground="{StaticResource MutedTextBrush}" />
                        <TextBlock x:Name="StatusText" Text="Отключено" FontSize="22" FontWeight="SemiBold" Margin="0,4,0,2" />
                        <TextBlock x:Name="StatusMessage" Text="Введите данные устройства и нажмите подключить." Foreground="{StaticResource MutedTextBrush}" TextWrapping="Wrap" />
                        <ProgressBar x:Name="ConnectionProgress"
                                     Height="4"
                                     Margin="0,14,0,0"
                                     IsIndeterminate="True"
                                     Visibility="Collapsed"
                                     Foreground="{StaticResource AccentBrush}"
                                     Background="#2D3944" />
                    </StackPanel>
                </Border>

                <Border Background="{StaticResource PanelBrush}" CornerRadius="8" Padding="20" Margin="0,0,0,16">
                    <StackPanel>
                        <TextBlock Text="Профиль" Foreground="{StaticResource MutedTextBrush}" />
                        <Grid Margin="0,6,0,14">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="96" />
                            </Grid.ColumnDefinitions>
                            <ComboBox x:Name="ProfileBox"
                                      Margin="0"
                                      SelectionChanged="ProfileBox_SelectionChanged" />
                            <Button Grid.Column="1"
                                    x:Name="DeleteProfileButton"
                                    Content="Удалить"
                                    Margin="10,0,0,0"
                                    MinHeight="38"
                                    Padding="10,6"
                                    FontSize="13"
                                    Background="#2D3944"
                                    Foreground="{StaticResource TextBrush}"
                                    Click="DeleteProfileButton_Click" />
                        </Grid>

                        <TextBlock Text="Код подключения" Foreground="{StaticResource MutedTextBrush}" />
                        <TextBox x:Name="ConnectionCodeBox"
                                 MinHeight="78"
                                 MaxHeight="120"
                                 TextWrapping="Wrap"
                                 AcceptsReturn="True"
                                 VerticalScrollBarVisibility="Auto"
                                 ToolTip="Вставьте omega://connect/... или OMEGA_* настройки" />

                        <Button x:Name="SaveCodeButton"
                                Content="Добавить код"
                                Background="#2D3944"
                                Foreground="{StaticResource TextBrush}"
                                Margin="0,0,0,10"
                                Click="SaveCodeButton_Click" />

                        <Button x:Name="ConnectButton"
                                Content="Подключить"
                                Style="{StaticResource PrimaryButtonStyle}"
                                Click="ConnectButton_Click" />
                    </StackPanel>
                </Border>

                <Border Background="{StaticResource PanelBrush}" CornerRadius="8" Padding="20" Margin="0,0,0,16">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <StackPanel Grid.Row="0" Grid.Column="0" Margin="0,0,16,14">
                            <TextBlock Text="Качество" Foreground="{StaticResource MutedTextBrush}" />
                            <TextBlock x:Name="QualityText" Text="n/a" FontSize="16" FontWeight="SemiBold" />
                        </StackPanel>
                        <StackPanel Grid.Row="0" Grid.Column="1" Margin="0,0,0,14">
                            <TextBlock Text="RTT" Foreground="{StaticResource MutedTextBrush}" />
                            <TextBlock x:Name="RttText" Text="n/a" FontSize="16" FontWeight="SemiBold" />
                        </StackPanel>
                        <StackPanel Grid.Row="1" Grid.Column="0" Margin="0,0,16,14">
                            <TextBlock Text="MTU" Foreground="{StaticResource MutedTextBrush}" />
                            <TextBlock x:Name="MtuText" Text="n/a" FontSize="16" FontWeight="SemiBold" />
                        </StackPanel>
                        <StackPanel Grid.Row="1" Grid.Column="1" Margin="0,0,0,14">
                            <TextBlock Text="Транспорт" Foreground="{StaticResource MutedTextBrush}" />
                            <TextBlock x:Name="TransportText" Text="n/a" FontSize="16" FontWeight="SemiBold" />
                        </StackPanel>
                        <StackPanel Grid.Row="2" Grid.ColumnSpan="2">
                            <TextBlock Text="Tunnel IP" Foreground="{StaticResource MutedTextBrush}" />
                            <TextBlock x:Name="TunnelIpText" Text="n/a" FontSize="16" FontWeight="SemiBold" />
                        </StackPanel>
                    </Grid>
                </Border>

                <Expander Header="Расширенные настройки" Foreground="{StaticResource TextBrush}">
                    <Border Background="{StaticResource PanelBrush}" CornerRadius="8" Padding="20" Margin="0,10,0,0">
                        <StackPanel>
                            <TextBlock Text="Имя устройства" Foreground="{StaticResource MutedTextBrush}" />
                            <TextBox x:Name="DeviceNameBox" />

                            <TextBlock Text="Транспорт" Foreground="{StaticResource MutedTextBrush}" />
                            <ComboBox x:Name="TransportBox">
                                <ComboBoxItem Content="auto" IsSelected="True" />
                                <ComboBoxItem Content="udp" />
                                <ComboBoxItem Content="tcp" />
                            </ComboBox>

                            <Border Background="#1B2530" CornerRadius="8" Padding="14" Margin="0,0,0,12">
                                <StackPanel>
                                    <CheckBox x:Name="RealityEnabledBox"
                                              Content="Включить обход (REALITY)"
                                              Style="{StaticResource ToggleSwitchStyle}" />
                                    <TextBlock Text="REALITY-код из админки"
                                               Foreground="{StaticResource MutedTextBrush}"
                                               Margin="0,12,0,0" />
                                    <TextBox x:Name="RealityCodeBox"
                                             MinHeight="60"
                                             MaxHeight="120"
                                             TextWrapping="Wrap"
                                             AcceptsReturn="False"
                                             VerticalScrollBarVisibility="Auto"
                                             ToolTip="Скопируйте omega-reality://… из админки сервера" />
                                    <TextBlock Text="Включайте, если в сети режут всё кроме TLS к белым спискам. Один код заменяет все ручные настройки."
                                               Foreground="{StaticResource MutedTextBrush}"
                                               TextWrapping="Wrap"
                                               FontSize="12"
                                               Margin="0,4,0,0" />
                                </StackPanel>
                            </Border>

                            <TextBlock Text="Kill switch" Foreground="{StaticResource MutedTextBrush}" />
                            <ComboBox x:Name="KillSwitchBox">
                                <ComboBoxItem Content="soft" IsSelected="True" />
                                <ComboBoxItem Content="strict" />
                                <ComboBoxItem Content="off" />
                            </ComboBox>

                            <TextBlock Text="DNS leak guard" Foreground="{StaticResource MutedTextBrush}" />
                            <ComboBox x:Name="DnsLeakGuardBox">
                                <ComboBoxItem Content="warn" IsSelected="True" />
                                <ComboBoxItem Content="strict" />
                                <ComboBoxItem Content="off" />
                            </ComboBox>

                            <CheckBox x:Name="AutostartBox"
                                      Content="Запускать Omega VPN при входе в Windows"
                                      Style="{StaticResource ToggleSwitchStyle}"
                                      Margin="0,4,0,0" />
                        </StackPanel>
                    </Border>
                </Expander>
            </StackPanel>
        </ScrollViewer>

        <TextBlock Grid.Row="2"
                   x:Name="FooterText"
                   Text="Журнал: omega-client/state/runtime.log"
                   Foreground="{StaticResource MutedTextBrush}"
                   Margin="0,18,0,0"
                   TextWrapping="Wrap" />
    </Grid>
</Window>
